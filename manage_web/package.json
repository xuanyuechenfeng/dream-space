    "test:quality": "npm run typecheck && npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.14",
    "vitest": "3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
