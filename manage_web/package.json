{
  "name": "@dream-space/manage_web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "test:unit": "vitest run --config vitest.config.ts",
